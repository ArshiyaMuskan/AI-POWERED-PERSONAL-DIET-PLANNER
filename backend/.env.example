APP_NAME=AI Personal Diet Planner
ENVIRONMENT=development
SECRET_KEY=change-this-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
DATABASE_URL=sqlite:///./diet_planner.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=5

# Optional external AI provider.
# Keep empty to use the local rule-based engine.
AI_PROVIDER=local
AI_API_URL=
AI_API_KEY=
AI_MODEL=

# Optional Supabase storage adapter settings.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=meal-files
